limit_req_zone $binary_remote_addr zone=checkout:10m rate=${CHECKOUT_RATE};
proxy_cache_path /var/cache/nginx keys_zone=static:10m max_size=100m;

upstream api_pool {
    least_conn;
    server api:3000;
    keepalive 64;
}

upstream web_pool {
    server web:3000;
}

server {
    listen 80;

    location = /api/checkout {
        limit_req zone=checkout burst=${CHECKOUT_BURST} nodelay;
        limit_req_status 429;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_pass http://api_pool/checkout;
    }

    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_pass http://api_pool/;
    }

    location /_next/static/ {
        proxy_cache static;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        proxy_pass http://web_pool;
    }

    location / {
        proxy_pass http://web_pool;
    }
}
